# Configuration Caddy pour maisonnette.fr — Déploiement Hetzner
#
# Architecture:
# 1. maisonnette-pecheur-bertheaume.fr → Site public (ouvert à tous)
# 2. backoffice.maisonnette-pecheur-bertheaume.fr → Sous-domaine Tailscale
# 3. /backoffice sur domaine principal → Aussi restreint Tailscale
# 4. /api/backoffice/* → Endpoints protégés JWT + restriction IP Tailscale
#
# Let's Encrypt HTTPS automatique via Caddy.
# Restrict backoffice access to Tailscale network only (100.0.0.0/8)

{
	email {$ACME_EMAIL}
}

# ========================================================================
# BACKOFFICE SUBDOMAIN: backoffice.maisonnette-pecheur-bertheaume.fr
# Protégé par JWT authentication (vrai protection au lieu de IP restriction)
# ========================================================================
backoffice.{$DOMAIN} {
	# Reverse proxy to backoffice frontend
	reverse_proxy frontend:5173 {
		header_uri / Host {http.request.host}
		header_uri / X-Forwarded-For {http.request.remote}
		header_uri / X-Forwarded-Proto {http.request.proto}
	}

	# API routes go to backend
	@api path /api/*
	handle @api {
		reverse_proxy backend:3001 {
			header_uri / X-Forwarded-For {http.request.remote}
			header_uri / X-Forwarded-Proto {http.request.proto}
		}
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ========================================================================
# SITE PUBLIC: maisonnette-pecheur-bertheaume.fr
# Accessible à tous — site statique (zéro risque d'injection)
# ========================================================================
{$DOMAIN}, www.{$DOMAIN} {
	encode gzip zstd

	# Route /backoffice vers frontend (protégé par JWT dans SvelteKit)
	@backoffice path /backoffice*
	handle @backoffice {
		reverse_proxy frontend:5173 {
			header_uri / Host {http.request.host}
			header_uri / X-Forwarded-For {http.request.remote}
			header_uri / X-Forwarded-Proto {http.request.proto}
		}
	}

	# API backoffice - protégé par JWT middleware au backend
	@api_backoffice path /api/backoffice*
	handle @api_backoffice {
		reverse_proxy backend:3001 {
			header_uri / X-Forwarded-For {http.request.remote}
			header_uri / X-Forwarded-Proto {http.request.proto}
		}
	}

	# Health check (public)
	handle /health {
		reverse_proxy backend:3001
	}

	# Uploads (public)
	handle /uploads/* {
		reverse_proxy backend:3001
	}

	# API public (calendar, etc)
	handle /api/* {
		reverse_proxy backend:3001
	}

	# Tout le reste → frontend (public)
	handle {
		reverse_proxy frontend:5173
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
