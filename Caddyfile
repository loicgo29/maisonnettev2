# Reverse proxy de production — maisonnette-pecheur-bertheaume.fr
#
# Deux volets nettement séparés (cf. docker-compose.prod.yml) :
#   public     nginx servant public-site/, du HTML statique sans exécution
#              côté serveur : c'est la seule chose exposée à un visiteur anonyme.
#   backoffice SvelteKit, protégé par JWT, atteint via /backoffice ou le
#              sous-domaine dédié.
#   backend    Express, seule brique parlant à PostgreSQL.
#
# Caddy obtient et renouvelle les certificats Let's Encrypt tout seul ; DOMAIN
# et ACME_EMAIL viennent de docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

# ========================================================================
# SOUS-DOMAINE BACKOFFICE — backoffice.<domaine>
# ========================================================================
backoffice.{$DOMAIN} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle /uploads/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy backoffice:5173
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ========================================================================
# FOURNISSEUR D'IDENTITÉ — auth.<domaine>
# Keycloak, TLS terminé ici : il tourne en clair sur le réseau interne.
# ========================================================================
auth.{$DOMAIN} {
	encode gzip zstd

	reverse_proxy keycloak:8080 {
		# Keycloak fabrique ses URL de redirection à partir de ces en-têtes.
		# Sans eux, il les forge en http et le navigateur refuse le flux, sans
		# message qui désigne la cause.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ========================================================================
# alo — sous-domaine alo.<domaine>, comptabilité familiale
#
# alo n'a aucune authentification propre : forward_auth demande au backoffice
# si la requête est authentifiée, et ne sert la page qu'en cas de réponse 200.
# Sous-domaine et non chemin `/alo` : le nginx interne d'alo proxifie déjà
# `/api` vers son backend, un chemin entrerait en collision avec l'API de
# maisonnettev2. Miroir exact du bloc `alo.maisonnette.localhost` du Caddyfile
# de développement.
# ========================================================================
alo.{$DOMAIN} {
	encode gzip zstd

	forward_auth backend:3001 {
		uri /api/backoffice/auth/verify

		@refuse status 401 403
		handle_response @refuse {
			redir * https://{$DOMAIN}/backoffice/login 302
		}
	}

	reverse_proxy alo-frontend:80

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server

		# Sans cela, le navigateur ressert alo depuis son cache après une
		# déconnexion alors qu'il n'y a plus de session.
		Cache-Control "no-store"
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ========================================================================
# SITE PUBLIC — <domaine> et www.<domaine>
# ========================================================================
{$DOMAIN}, www.{$DOMAIN} {
	encode gzip zstd

	# Backoffice accessible aussi depuis le domaine principal.
	handle /backoffice* {
		reverse_proxy backoffice:5173
	}

	# Admin (réservations/messages) — redirige vers Keycloak OAuth
	handle /admin* {
		reverse_proxy backoffice:5173
	}

	# Ressources internes de SvelteKit : servies depuis le même conteneur,
	# sinon les pages du backoffice arrivent sans style ni JavaScript.
	handle /_app/* {
		reverse_proxy backoffice:5173
	}

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle /health {
		reverse_proxy backend:3001
	}

	# Photos des gîtes, servies par express.static du backend.
	handle /uploads/* {
		reverse_proxy backend:3001
	}

	# Tout le reste : le site statique.
	handle {
		reverse_proxy public:80
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
