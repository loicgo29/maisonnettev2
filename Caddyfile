# Configuration Caddy pour maisonnette-pecheur-bertheaume.fr
#
# Architecture:
# 1. maisonnette-pecheur-bertheaume.fr → Site public (ouvert à tous)
# 2. backoffice.maisonnette-pecheur-bertheaume.fr → Sous-domaine backoffice
# 3. /backoffice sur domaine principal → Chemin backoffice
# 4. JWT authentication protège le backoffice
#
# Let's Encrypt HTTPS automatique via Caddy.

{
	email {$ACME_EMAIL}
}

# ========================================================================
# BACKOFFICE SUBDOMAIN: backoffice.maisonnette-pecheur-bertheaume.fr
# Protégé par JWT authentication dans SvelteKit
# ========================================================================
backoffice.{$DOMAIN} {
	encode gzip zstd

	# API routes → backend
	@api path /api/*
	handle @api {
		reverse_proxy backend:3001
	}

	# Tout le reste → frontend (SvelteKit)
	handle {
		reverse_proxy frontend:5173
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ========================================================================
# SITE PUBLIC: maisonnette-pecheur-bertheaume.fr
# Accessible à tous — site statique + backoffice via /backoffice
# ========================================================================
{$DOMAIN}, www.{$DOMAIN} {
	encode gzip zstd

	# Route /backoffice vers frontend (protégé par JWT dans SvelteKit)
	@backoffice path /backoffice*
	handle @backoffice {
		reverse_proxy frontend:5173
	}

	# API backoffice - protégé par JWT middleware au backend
	@api_backoffice path /api/backoffice*
	handle @api_backoffice {
		reverse_proxy backend:3001
	}

	# Health check (public)
	handle /health {
		reverse_proxy backend:3001
	}

	# Uploads (public)
	handle /uploads/* {
		reverse_proxy backend:3001
	}

	# API public (calendar, etc)
	handle /api/* {
		reverse_proxy backend:3001
	}

	# Tout le reste → frontend (public)
	handle {
		reverse_proxy frontend:5173
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
