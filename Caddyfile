# Reverse proxy de production — maisonnette-pecheur-bertheaume.fr
#
# Deux volets nettement séparés (cf. docker-compose.prod.yml) :
#   public     nginx servant public-site/, du HTML statique sans exécution
#              côté serveur : c'est la seule chose exposée à un visiteur anonyme.
#   backoffice SvelteKit, protégé par JWT, atteint via /backoffice ou le
#              sous-domaine dédié.
#   backend    Express, seule brique parlant à PostgreSQL.
#
# Caddy obtient et renouvelle les certificats Let's Encrypt tout seul ; DOMAIN
# et ACME_EMAIL viennent de docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

# ========================================================================
# FOURNISSEUR D'IDENTITÉ — auth.<domaine>
# Keycloak, TLS terminé ici : il tourne en clair sur le réseau interne.
# ========================================================================
auth.{$DOMAIN} {
	encode gzip zstd

	reverse_proxy keycloak:8080 {
		# Keycloak fabrique ses URL de redirection à partir de ces en-têtes.
		# Sans eux, il les forge en http et le navigateur refuse le flux, sans
		# message qui désigne la cause.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ========================================================================
# REDIRECTION www → domaine nu — évite le contenu dupliqué aux yeux des
# moteurs de recherche (les deux répondaient 200 avant ce changement).
# ========================================================================
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ========================================================================
# SITE PUBLIC — <domaine>
# ========================================================================
{$DOMAIN} {
	encode gzip zstd

	# alo, servi sous /admin/alo (plus de sous-domaine dédié depuis le
	# 2026-09-14 — un seul domaine à retenir). handle_path retire le
	# préfixe avant de transmettre : alo-frontend reçoit les requêtes
	# comme s'il était servi à sa propre racine (aucun changement côté
	# nginx interne d'alo). Doit précéder `handle /admin*` ci-dessous,
	# sinon ce dernier interceptait tout /admin/alo/* en premier.
	# Aucune vérification d'auth ici : alo n'en a pas, et ce chemin est
	# aussi peu protégé qu'un accès direct par URL — accepté comme
	# compromis pour ne pas construire de garde dédié.
	handle_path /admin/alo* {
		reverse_proxy alo-frontend:80
	}

	# Admin (réservations/messages) — redirige vers Keycloak OAuth
	handle /admin* {
		reverse_proxy backoffice:5173
	}

	# Ressources internes de SvelteKit : servies depuis le même conteneur,
	# sinon les pages du backoffice arrivent sans style ni JavaScript.
	handle /_app/* {
		reverse_proxy backoffice:5173
	}

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle /health {
		reverse_proxy backend:3001
	}

	# Photos des gîtes, servies par express.static du backend.
	handle /uploads/* {
		reverse_proxy backend:3001
	}

	# Tout le reste : le site statique.
	handle {
		reverse_proxy public:80
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
