# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/maisonnette

# Email (Resend)
RESEND_API_KEY=re_xxxxx

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_WHATSAPP_NUMBER=+1234567890

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx

# Authentik OIDC
KEYCLOAK_REALM_URL=http://localhost:9000/application/o/maisonnettev2/
KEYCLOAK_CLIENT_ID=maisonnettev2-backend (if needed for server-to-server)

# Google Calendar (Service Account)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json

# Stripe Webhooks
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Sentry Error Tracking
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=development

# Owner Contact
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+33612345678
