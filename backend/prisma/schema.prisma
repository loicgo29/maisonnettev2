// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" pour le développement sur macOS.
  // Les cibles musl-openssl-3.0.x sont indispensables en conteneur : l'image
  // node:20-alpine embarque OpenSSL 3, alors que le moteur par défaut réclame
  // libssl.so.1.1 et échoue au démarrage.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "alo"]
}

model Gite {
  id                String        @id @default(cuid())
  slug              String        @unique
  nom               String
  description       String        @db.Text
  adresse           String
  capacite          Int
  prixNuit          Float
  googleCalendarId  String?       // Google Calendar ID for availability sync
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  photos       Photo[]
  reservations Reservation[]

  @@schema("public")
  @@index([slug])
}

model Photo {
  id        String   @id @default(cuid())
  giteId    String
  gite      Gite     @relation(fields: [giteId], references: [id], onDelete: Cascade)
  url       String
  categorie String   // EXTERIEUR | SALON | CUISINE | CHAMBRE | SDB | OUTDOOR
  ordre     Int      @default(0) // manual sort order within category
  alt       String?
  createdAt DateTime @default(now())

  @@schema("public")
  @@index([giteId])
  @@index([categorie])
}

model Reservation {
  id                      String   @id @default(cuid())
  giteId                  String
  gite                    Gite     @relation(fields: [giteId], references: [id], onDelete: Cascade)
  dateDebut               DateTime
  dateFin                 DateTime
  statut                  String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  clientNom               String
  clientEmail             String
  clientTelephone         String
  montantTotal            Float
  stripePaymentIntentId   String?  // Stripe payment tracking
  googleCalendarEventId   String?  // Google Calendar event link
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@schema("public")
  @@index([giteId])
  @@index([statut])
  @@index([dateDebut, dateFin])
}

// ALO Module Tables
model aloAccounts {
  id              Int                @id
  name            String
  institution     String?
  owner           AloAccountOwner
  current_balance Decimal?  @db.Decimal(10, 2)
  updated_at      DateTime?
  expenses        aloExpenses[]

  @@schema("alo")
  @@map("accounts")
}

model aloExpenses {
  id          Int       @id @default(autoincrement())
  date        DateTime
  // Decimal et non Float : montants comptables, le flottant introduit des
  // erreurs d'arrondi sur les agrégats.
  amount      Decimal   @db.Decimal(10, 2)
  label       String?
  category    AloExpenseCategory?
  source      AloExpenseSource?
  status      AloExpenseStatus?
  comment     String?
  sharing_mode String?
  account_id  Int
  period_id   Int?
  created_at  DateTime
  updated_at  DateTime
  account     aloAccounts @relation(fields: [account_id], references: [id])

  @@schema("alo")
  @@map("expenses")
  @@index([account_id])
  @@index([period_id])
}

model aloPeriods {
  id        Int       @id @default(autoincrement())
  name      String?
  startDate DateTime
  endDate   DateTime
  status    AloPeriodStatus?
  createdAt DateTime

  @@schema("alo")
  @@map("periods")
}

// Enums PostgreSQL du schéma `alo`, propriété d'alo (SQLAlchemy les crée).
// Prisma doit les déclarer pour lire les colonnes : sans cela il attend des
// String et échoue sur « incompatible value ».
enum AloAccountOwner {
  adulte1
  adulte2
  commun

  @@map("account_owner")
  @@schema("alo")
}

enum AloExpenseCategory {
  quotepart
  cinquante_cinquante @map("50/50")
  dette
  brico
  virement
  trop_plein
  regule_periode
  divers

  @@map("expense_category")
  @@schema("alo")
}

enum AloExpenseSource {
  manuel
  telegram
  csv_import
  bankin
  brico

  @@map("expense_source")
  @@schema("alo")
}

enum AloExpenseStatus {
  draft
  frozen

  @@map("expense_status")
  @@schema("alo")
}

enum AloPeriodStatus {
  draft
  frozen

  @@map("period_status")
  @@schema("alo")
}
