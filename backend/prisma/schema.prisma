// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" pour le développement sur macOS.
  // Les cibles musl-openssl-3.0.x sont indispensables en conteneur : l'image
  // node:20-alpine embarque OpenSSL 3, alors que le moteur par défaut réclame
  // libssl.so.1.1 et échoue au démarrage.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "alo"]
}

model Gite {
  id                String        @id @default(cuid())
  slug              String        @unique
  nom               String
  description       String        @db.Text
  adresse           String
  capacite          Int
  prixNuit          Float
  googleCalendarId  String?       // Google Calendar ID for availability sync
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  photos       Photo[]
  reservations Reservation[]

  @@schema("public")
  @@index([slug])
}

model Photo {
  id        String   @id @default(cuid())
  giteId    String
  gite      Gite     @relation(fields: [giteId], references: [id], onDelete: Cascade)
  url       String
  categorie String   // EXTERIEUR | SALON | CUISINE | CHAMBRE | SDB | OUTDOOR
  ordre     Int      @default(0) // manual sort order within category
  alt       String?
  createdAt DateTime @default(now())

  @@schema("public")
  @@index([giteId])
  @@index([categorie])
}

model MessageSejour {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  // CANAL | GUIDE | RAPPEL_ARRIVEE | ARRIVEE_OK | PLANTES | CHECKOUT | RETOUR
  // | RELANCE_ACOMPTE | RELANCE_SOLDE
  type          String
  // EMAIL | SMS | WHATSAPP — tout part par e-mail en v1
  canal         String      @default("EMAIL")
  // PLANIFIE | ENVOYE | ECHEC | ANNULE | IMPOSSIBLE
  // IMPOSSIBLE : pas d'adresse e-mail. Un état distinct plutôt qu'un échec,
  // pour que le backoffice puisse le signaler et proposer de saisir l'adresse
  // — jamais d'échec silencieux.
  statut        String      @default("PLANIFIE")

  planifieLe    DateTime
  envoyeLe      DateTime?
  // Motif conservé : c'est ce qui permet le réessai depuis /admin/messages.
  erreur        String?
  sujet         String?
  corps         String?     @db.Text
  // RELANCE_ACOMPTE / RELANCE_SOLDE seulement : ces deux types ne partent
  // jamais tout seuls (argent en jeu), même avec MESSAGES_AUTO=true. Le
  // moteur notifie Loïc par ntfy avec le texte prêt à envoyer, puis pose ce
  // drapeau pour ne pas re-notifier à chaque passage horaire tant que le
  // statut reste PLANIFIE (envoi manuel depuis /admin/messages).
  notifie       Boolean     @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@schema("public")
  @@index([reservationId])
  @@index([statut, planifieLe])
  // Garde-fou en base et pas seulement dans le code : deux exécutions
  // simultanées du planificateur ne peuvent pas créer de doublon.
  @@unique([reservationId, type])
}

model Reservation {
  id                      String   @id @default(cuid())
  giteId                  String
  gite                    Gite     @relation(fields: [giteId], references: [id], onDelete: Cascade)
  dateDebut               DateTime
  dateFin                 DateTime
  statut                  String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  clientNom               String
  clientPrenom            String   @default("")
  // Facultatif : Airbnb et Leboncoin masquent souvent l'adresse réelle.
  // Sans elle, les messages passent en IMPOSSIBLE plutôt que d'échouer.
  clientEmail             String?
  clientTelephone         String
  montantTotal            Float
  stripePaymentIntentId   String?  // Stripe payment tracking
  googleCalendarEventId   String?  // Google Calendar event link

  // true si les échanges avec ce client tutoient / l'appellent par son
  // prénom — Leboncoin et le direct s'y prêtent, Airbnb et Booking restent
  // plus formels par défaut.
  appelerParPrenom        Boolean  @default(false)
  // Absent (null) = pas encore renseigné, distinct de 0 qui affirmerait un
  // studio sans lit — la case "pas d'info" du formulaire correspond à null.
  nombreLits              Int?
  // Demandes du client hors trame standard : vélo à prévoir, arrivée à une
  // heure inhabituelle, etc. Relu à la main, jamais par le moteur de messages.
  attentesClient          String?  @db.Text

  // Suivi des paiements, utile aux réservations directes et Leboncoin :
  // Airbnb et Booking encaissent eux-mêmes. Affiché dans le backoffice, il ne
  // déclenche aucun message — la séquence suit le séjour, pas les paiements.
  acompteVerse            Boolean  @default(false)
  soldeVerse              Boolean  @default(false)
  // AIRBNB | BOOKING | LEBONCOIN | DIRECT | AUTRE
  plateforme              String   @default("DIRECT")
  notesInternes           String?  @db.Text

  messages                MessageSejour[]

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@schema("public")
  @@index([giteId])
  @@index([statut])
  @@index([dateDebut, dateFin])
}

// Backoffice Users — Simple authentication (username + bcrypt hash)
model BackofficeUser {
  id        String   @id @default(cuid())
  username  String   @unique
  hash      String   // bcrypt hash of password
  email     String?
  role      String   @default("staff") // staff | admin
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  @@schema("public")
  @@index([username])
}

// ALO Module Tables
model aloAccounts {
  id              Int                @id
  name            String
  institution     String?
  // varchar et non l'enum AloAccountOwner : en production cette colonne est
  // un `character varying` contenant de vrais prénoms ("loic", "alice"), pas
  // les valeurs adulte1/adulte2/commun de l'enum. Le déclarer en enum faisait
  // planter Prisma dès qu'il lisait une vraie ligne — dormant seulement parce
  // que le module /api/alo est désactivé en prod (ALO_ENABLED). Constaté le
  // 2026-09-15 en restaurant un dump de prod en local.
  owner           String
  current_balance Decimal?  @db.Decimal(10, 2)
  updated_at      DateTime?
  expenses        aloExpenses[]

  @@schema("alo")
  @@map("accounts")
}

model aloExpenses {
  id          Int       @id @default(autoincrement())
  date        DateTime
  // Decimal et non Float : montants comptables, le flottant introduit des
  // erreurs d'arrondi sur les agrégats.
  amount      Decimal   @db.Decimal(10, 2)
  label       String?
  category    AloExpenseCategory?
  source      AloExpenseSource?
  status      AloExpenseStatus?
  comment     String?
  sharing_mode String?
  account_id  Int
  period_id   Int?
  created_at  DateTime
  updated_at  DateTime
  account     aloAccounts @relation(fields: [account_id], references: [id])

  @@schema("alo")
  @@map("expenses")
  @@index([account_id])
  @@index([period_id])
}

model aloPeriods {
  id        Int       @id @default(autoincrement())
  name      String?
  startDate DateTime
  endDate   DateTime
  status    AloPeriodStatus?
  createdAt DateTime

  @@schema("alo")
  @@map("periods")
}

// Enums PostgreSQL du schéma `alo`, propriété d'alo (SQLAlchemy les crée).
// Prisma doit les déclarer pour lire les colonnes : sans cela il attend des
// String et échoue sur « incompatible value ».
//
// AloAccountOwner n'est plus rattaché à aucun champ (accounts.owner est un
// varchar en production, cf. commentaire du modèle) mais reste déclaré : le
// type existe en base des deux côtés, et le retirer d'ici ferait générer à
// Prisma un DROP TYPE qui s'exécuterait aussi en production, sur un schéma
// qui appartient à SQLAlchemy.
enum AloAccountOwner {
  adulte1
  adulte2
  commun

  @@map("account_owner")
  @@schema("alo")
}

enum AloExpenseCategory {
  quotepart
  cinquante_cinquante @map("50/50")
  dette
  brico
  virement
  trop_plein
  regule_periode
  divers

  @@map("expense_category")
  @@schema("alo")
}

enum AloExpenseSource {
  manuel
  telegram
  csv_import
  bankin
  brico

  @@map("expense_source")
  @@schema("alo")
}

enum AloExpenseStatus {
  draft
  frozen

  @@map("expense_status")
  @@schema("alo")
}

enum AloPeriodStatus {
  draft
  frozen

  @@map("period_status")
  @@schema("alo")
}
