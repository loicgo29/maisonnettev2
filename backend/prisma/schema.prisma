// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" pour le développement sur macOS.
  // Les cibles musl-openssl-3.0.x sont indispensables en conteneur : l'image
  // node:20-alpine embarque OpenSSL 3, alors que le moteur par défaut réclame
  // libssl.so.1.1 et échoue au démarrage.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gite {
  id                String        @id @default(cuid())
  slug              String        @unique
  nom               String
  description       String        @db.Text
  adresse           String
  capacite          Int
  prixNuit          Float
  googleCalendarId  String?       // Google Calendar ID for availability sync
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  photos       Photo[]
  reservations Reservation[]

  @@index([slug])
}

model Photo {
  id        String   @id @default(cuid())
  giteId    String
  gite      Gite     @relation(fields: [giteId], references: [id], onDelete: Cascade)
  url       String
  categorie String   // EXTERIEUR | SALON | CUISINE | CHAMBRE | SDB | OUTDOOR
  ordre     Int      @default(0) // manual sort order within category
  alt       String?
  createdAt DateTime @default(now())

  @@index([giteId])
  @@index([categorie])
}

model Reservation {
  id                      String   @id @default(cuid())
  giteId                  String
  gite                    Gite     @relation(fields: [giteId], references: [id], onDelete: Cascade)
  dateDebut               DateTime
  dateFin                 DateTime
  statut                  String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  clientNom               String
  clientEmail             String
  clientTelephone         String
  montantTotal            Float
  stripePaymentIntentId   String?  // Stripe payment tracking
  googleCalendarEventId   String?  // Google Calendar event link
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([giteId])
  @@index([statut])
  @@index([dateDebut, dateFin])
}

// ALO Module Tables
model aloAccounts {
  id              Int                @id
  name            String
  institution     String?
  owner           String?
  current_balance Decimal?  @db.Decimal(10, 2)
  updated_at      DateTime?
  expenses        aloExpenses[]

  @@map("alo_accounts")
}

model aloExpenses {
  id          Int       @id @default(autoincrement())
  date        DateTime
  // Decimal et non Float : montants comptables, le flottant introduit des
  // erreurs d'arrondi sur les agrégats.
  amount      Decimal   @db.Decimal(10, 2)
  label       String?
  category    String?
  source      String?
  status      String?
  comment     String?
  sharing_mode String?
  account_id  Int
  period_id   Int?
  created_at  DateTime
  updated_at  DateTime
  account     aloAccounts @relation(fields: [account_id], references: [id])

  @@map("alo_expenses")
  @@index([account_id])
  @@index([period_id])
}

model aloPeriods {
  id        Int       @id @default(autoincrement())
  name      String?
  startDate DateTime
  endDate   DateTime
  status    String?
  createdAt DateTime

  @@map("alo_periods")
}
