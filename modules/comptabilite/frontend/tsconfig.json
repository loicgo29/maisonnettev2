{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,

		/* Bundler mode */
		"module": "ESNext",
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
	"exclude": ["node_modules", "build", "dist"]
}
