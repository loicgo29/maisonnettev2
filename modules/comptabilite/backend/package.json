{
  "name": "comptabilite-backend",
  "version": "0.1.0",
  "description": "Comptabilite module — SASU invoices + transactions + Sage sync",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest"
