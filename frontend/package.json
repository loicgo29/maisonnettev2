{
	"name": "frontend-new",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 8030",
		"dev:with-check": "vite dev --port 8030 & sleep 8 && npm run healthcheck",
		"healthcheck": "bash ./healthcheck.sh http://localhost:8030",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:oauth": "npm run test:e2e:oauth && npm run test:bdd:oauth && npm run test:unit:oauth",
		"test:e2e:oauth": "playwright test ../tests/e2e/admin-oauth-login.spec.ts",
		"test:e2e:oauth:ui": "playwright test --ui ../tests/e2e/admin-oauth-login.spec.ts",
		"test:e2e:oauth:debug": "playwright test --debug ../tests/e2e/admin-oauth-login.spec.ts",
		"test:bdd:oauth": "cucumber-js ../tests/features/admin-oauth-login.feature --require ../tests/steps/admin-oauth-login.steps.js",
		"test:bdd:oauth:report": "cucumber-js ../tests/features/admin-oauth-login.feature --format html:../test-results/cucumber-report.html",
		"test:unit:oauth": "vitest ../tests/unit/auth.test.ts",
		"test:coverage": "vitest ../tests/unit/auth.test.ts --coverage"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"google-calendar-api": "^0.0.1"
	}
}
