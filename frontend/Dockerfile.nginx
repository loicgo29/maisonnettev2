# Build SvelteKit
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# SvelteKit résout `$env/static/public` à la construction : ces valeurs sont
# figées dans le paquet servi, elles ne peuvent pas être changées au démarrage.
#
# Il faut des ARG : sans eux, les `${VAR:-défaut}` du RUN ne lisaient jamais
# rien — docker build ne transmet pas l'environnement de l'hôte — et le défaut
# s'appliquait toujours. Le realm retombait donc sur `master`, celui de
# l'administration de Keycloak, dont les jetons n'ont rien à voir avec les
# utilisateurs de l'application. Et .env n'aide pas : .dockerignore l'exclut du
# contexte, à raison puisqu'il porte des secrets.
ARG PUBLIC_AUTH_URL=http://localhost:9001
ARG PUBLIC_AUTH_REALM=maisonnettev2
ARG PUBLIC_AUTH_CLIENT_ID=maisonnettev2-frontend

RUN PUBLIC_AUTH_URL="$PUBLIC_AUTH_URL" \
    PUBLIC_AUTH_REALM="$PUBLIC_AUTH_REALM" \
    PUBLIC_AUTH_CLIENT_ID="$PUBLIC_AUTH_CLIENT_ID" \
    npm run build

# Serve with Node.js
FROM node:20-alpine
WORKDIR /app

# Copy built app
COPY --from=builder /app/build ./build
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/static ./static

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:5173/', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

ENV NODE_ENV=production
ENV PORT=5173

CMD ["node", "build/index.js"]
