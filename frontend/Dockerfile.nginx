# Build SvelteKit
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# SvelteKit needs PUBLIC_* vars at build time (static site generation)
RUN PUBLIC_AUTH_URL=${PUBLIC_AUTH_URL:-http://localhost:9001} \
    PUBLIC_AUTH_REALM=${PUBLIC_AUTH_REALM:-master} \
    PUBLIC_AUTH_CLIENT_ID=${PUBLIC_AUTH_CLIENT_ID:-maisonnettev2-frontend} \
    npm run build

# Serve with Node.js
FROM node:20-alpine
WORKDIR /app

# Copy built app
COPY --from=builder /app/build ./build
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/static ./static

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:5173/', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

ENV NODE_ENV=production
ENV PORT=5173

CMD ["node", "build/index.js"]
