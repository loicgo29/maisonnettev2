# Secrets de maisonnettev2 — à copier en `.env`, jamais à versionner.
#
# Ce fichier ne contient QUE des secrets. Tout le reste — URL de Keycloak,
# realm, ports, noms de bases, contacts du gîte — est écrit dans
# docker-compose.yml, versionné et relu en revue.
#
# Pourquoi cette séparation : tant que configuration et secrets cohabitaient
# ici, la même variable était définie à deux endroits, et c'est le .env qui
# gagnait en silence. Une valeur pouvait être corrigée dans le compose sans
# aucun effet, et diverger d'une machine à l'autre sans que rien ne le signale.
# La règle : une variable a une seule source.
#
#   cp .env.example .env    puis renseigner ci-dessous.

# ── Obligatoires ──────────────────────────────────────────────────────
# Sans elles, `docker compose` refuse de démarrer en le disant clairement.

# Mot de passe PostgreSQL. Au premier démarrage, il est inscrit dans le volume :
# le changer ensuite exige de recréer la base.
#   openssl rand -base64 24
DB_PASSWORD=

# Signature des jetons du backoffice. Au moins 32 caractères — la validation au
# démarrage refuse plus court, un secret court se force.
# En changer déconnecte toutes les sessions en cours.
#   openssl rand -base64 48
JWT_SECRET=

# ── Facultatifs ───────────────────────────────────────────────────────
# Absents, la fonctionnalité correspondante reste simplement muette.

# Google Calendar — disponibilités du gîte.
# L'identifiant client, lui, n'est pas ici : il figure déjà dans l'authUrl que
# renvoie /api/calendar, donc dans le compose.
PRIVATE_GOOGLE_CLIENT_SECRET=
PRIVATE_GITE_CALENDAR_ID=
PUBLIC_CALENDAR_ID=
GOOGLE_API_KEY=

# Envoi des courriels (Resend).
RESEND_API_KEY=

# Remontée d'erreurs (Sentry). Le DSN vaut authentification, d'où sa place ici.
SENTRY_DSN=

# Paiements (Stripe). La clé publiable n'est pas secrète, mais elle change avec
# le compte : la garder ici évite de figer un compte dans le dépôt.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp (Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ── Surcharges de développement ───────────────────────────────────────
# Images d'alo à servir. Par défaut celles construites localement.
# ALO_BACKEND_IMAGE=ghcr.io/logo-projects/alo-backend:latest
# ALO_FRONTEND_IMAGE=ghcr.io/logo-projects/alo-frontend:latest
