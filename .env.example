# Copier en .env sur la machine hôte. Ne jamais commiter le .env rempli.
# IMPORTANT: Générer des secrets aléatoires avec: openssl rand -base64 32

# ========== HETZNER PRODUCTION (PHASE 1) ==========

# --- Domaines ---
DOMAIN=maisonnette.fr
PUBLIC_ORIGIN=https://maisonnette.fr

# --- Base de données ---
# Mot de passe FORT, généré aléatoirement (ex. openssl rand -base64 32)
DB_USER=maisonnettev2
DB_PASSWORD=<GENERATE-RANDOM-32-CHARS>
DB_NAME=maisonnettev2

# --- Authentification JWT ---
# Secret FORT pour signer les tokens JWT (ex. openssl rand -base64 32)
JWT_SECRET=<GENERATE-RANDOM-32-CHARS>

# --- Tunnel Cloudflare ---
# cloudflared tourne nativement sur le Mac Mini, hors de ce compose : aucun
# jeton n'est nécessaire ici. Déclarer dans l'ingress du tunnel :
#   maisonnette-pecheur-bertheaume.fr      -> http://localhost:8030
#   www.maisonnette-pecheur-bertheaume.fr  -> http://localhost:8030

# --- Contact Owner ---
# Affichés sur le site public et backoffice
OWNER_EMAIL=contact@maisonnette.fr
OWNER_PHONE=+33781103889

# --- Courrier électronique (Phase 2) ---
# RÉCEPTION : assurée par Cloudflare Email Routing (enregistrements MX).
#   contact@maisonnette.fr -> boîte Gmail personnelle.
#   Rien à configurer ici : la redirection se fait chez Cloudflare.
#
# ENVOI : assuré par Resend, qui exige un domaine vérifié (DKIM/SPF).
#   Les MX ne servent PAS à l'envoi.
# RESEND_API_KEY=<optional>
# MAIL_FROM=contact@maisonnette.fr

# --- Google OAuth (Calendrier) ---
# Créé via Google Cloud Console (https://console.cloud.google.com/)
# JAMAIS commiter les clés réelles - utiliser variables d'environnement
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=https://maisonnette-pecheur-bertheaume.fr/api/calendar/callback
GITE_CALENDAR_ID=primary

# --- Application ---
NODE_ENV=production
KEYCLOAK_REALM_URL=http://localhost:9001/realms/master/
PORT=3001

# --- Configuration locale (développement) ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8030
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
DB_HOST=localhost
DB_PORT=5433
VITE_API_URL=http://localhost:3001

# --- Services optionnels ---
# Paiement
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# SMS/WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
