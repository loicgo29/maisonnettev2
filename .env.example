# Copier en .env sur la machine hôte. Ne jamais commiter le .env rempli.

# --- Domaine public ---
DOMAIN=maisonnette-pecheur-bertheaume.fr
PUBLIC_ORIGIN=https://maisonnette-pecheur-bertheaume.fr

# --- Base de données ---
# Mot de passe fort, généré localement (ex. openssl rand -base64 32)
DB_USER=maisonnette
DB_PASSWORD=
DB_NAME=maisonnettev2

# --- Tunnel Cloudflare ---
# cloudflared tourne nativement sur le Mac Mini, hors de ce compose : aucun
# jeton n'est nécessaire ici. Déclarer dans l'ingress du tunnel :
#   maisonnette-pecheur-bertheaume.fr      -> http://localhost:8030
#   www.maisonnette-pecheur-bertheaume.fr  -> http://localhost:8030

# --- Courrier électronique ---
# RÉCEPTION : assurée par Cloudflare Email Routing (enregistrements MX).
#   contact@maisonnette-pecheur-bertheaume.fr -> boîte Gmail personnelle.
#   Rien à configurer ici : la redirection se fait chez Cloudflare.
#
# ENVOI : assuré par Resend, qui exige un domaine vérifié (DKIM/SPF).
#   Les MX ne servent PAS à l'envoi.
OWNER_EMAIL=
RESEND_API_KEY=
MAIL_FROM=contact@maisonnette-pecheur-bertheaume.fr

# --- Application ---
NODE_ENV=production
