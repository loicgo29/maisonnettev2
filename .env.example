# Copier en .env sur la machine hôte. Ne jamais commiter le .env rempli.

# --- Domaine public ---
DOMAIN=maisonnette-pecheur-bertheaume.fr
PUBLIC_ORIGIN=https://maisonnette-pecheur-bertheaume.fr

# --- Base de données ---
# Mot de passe fort, généré localement (ex. openssl rand -base64 32)
DB_USER=maisonnette
DB_PASSWORD=
DB_NAME=maisonnettev2

# --- Tunnel Cloudflare ---
# cloudflared tourne nativement sur le Mac Mini, hors de ce compose : aucun
# jeton n'est nécessaire ici. Déclarer dans l'ingress du tunnel :
#   maisonnette-pecheur-bertheaume.fr      -> http://localhost:8030
#   www.maisonnette-pecheur-bertheaume.fr  -> http://localhost:8030

# --- Courrier électronique ---
# RÉCEPTION : assurée par Cloudflare Email Routing (enregistrements MX).
#   contact@maisonnette-pecheur-bertheaume.fr -> boîte Gmail personnelle.
#   Rien à configurer ici : la redirection se fait chez Cloudflare.
#
# ENVOI : assuré par Resend, qui exige un domaine vérifié (DKIM/SPF).
#   Les MX ne servent PAS à l'envoi.
OWNER_EMAIL=
RESEND_API_KEY=
MAIL_FROM=contact@maisonnette-pecheur-bertheaume.fr

# --- Google OAuth (Calendrier) ---
# Créé via Google Cloud Console (https://console.cloud.google.com/)
# JAMAIS commiter les clés réelles - utiliser variables d'environnement
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=https://maisonnette-pecheur-bertheaume.fr/api/calendar/callback
GITE_CALENDAR_ID=primary

# --- Application ---
NODE_ENV=production
KEYCLOAK_REALM_URL=http://localhost:9001/realms/master/
PORT=3001

# --- Configuration locale (développement) ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8030
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
DB_HOST=localhost
DB_PORT=5433
VITE_API_URL=http://localhost:3001

# --- Services optionnels ---
# Paiement
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# SMS/WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
